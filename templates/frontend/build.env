# Build configuration. Keep commands compatible with /bin/sh in BUILD_IMAGE
# and use version-pinned container images.
DOCKERFILE=Dockerfile
BUILD_IMAGE=node:20.11-slim
RUNTIME_IMAGE=node:20.11-slim
INSTALL_COMMAND='npm ci'
BUILD_COMMAND='npm run build'
RUNTIME_PREPARE_COMMAND='mkdir -p /runtime/.next && cp -a .next/standalone/. /runtime/ && cp -a .next/static /runtime/.next/static && cp -a public /runtime/public'
START_COMMAND='node server.js'
HEALTHCHECK_COMMAND="node -e \"require('http').get('http://localhost:3000/', r => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1))\""
TEST_COMMAND='npm run lint && npm test'
