# Build configuration. Keep commands compatible with /bin/sh in BUILD_IMAGE
# and use version-pinned container images.
DOCKERFILE=Dockerfile
BUILD_IMAGE=node:20.11-slim
RUNTIME_IMAGE=node:20.11-slim
INSTALL_COMMAND='npm ci'
BUILD_COMMAND='npm run build'
RUNTIME_PREPARE_COMMAND='cp -a dist node_modules package.json /runtime/'
START_COMMAND='node dist/main.js'
HEALTHCHECK_COMMAND="node -e \"require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))\""
TEST_COMMAND='npm test'
