PLATFORM_DOMAIN=example.com

# Terminal monitoring is the default and consumes no monitoring container.
# To run Beszel Hub and its agent without Uptime Kuma, use:
# COMPOSE_PROFILES=beszel,agent
# Uptime Kuma is a separate optional profile:
# COMPOSE_PROFILES=uptime
# Beszel agent requires a system created in the Beszel Hub:
# BESZEL_AGENT_KEY=...
# BESZEL_AGENT_TOKEN=...
