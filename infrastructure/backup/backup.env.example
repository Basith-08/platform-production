# Runtime configuration for /srv/platform/backup. Never commit backup.env.
# Create a bot with @BotFather and keep this token secret.
TELEGRAM_BOT_TOKEN=
# Private chat ID allowed to trigger backups and receive backup files.
TELEGRAM_CHAT_ID=

# HTTPS Telegram Bot API endpoint. Keep default unless using a controlled proxy.
TELEGRAM_API_BASE=https://api.telegram.org

# Refuse to start if less than this many decimal GB remain on staging filesystem.
BACKUP_MIN_FREE_GB=3
TELEGRAM_RETRIES=3
TELEGRAM_RETRY_DELAY_SECONDS=10

# Safety limit below the Telegram Bot API upload limit.
TELEGRAM_MAX_FILE_MB=49
