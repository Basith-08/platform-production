# Runtime configuration for /srv/platform/backup. Never commit backup.env.
RCLONE_REMOTE=gdrive-backup
RCLONE_BASE_PATH=platform-production
RCLONE_CONFIG=/home/deploy/.config/rclone/rclone.conf

# Refuse to start if less than this many decimal GB remain on the staging filesystem.
BACKUP_MIN_FREE_GB=3
RCLONE_RETRIES=3
RCLONE_RETRY_DELAY_SECONDS=10
